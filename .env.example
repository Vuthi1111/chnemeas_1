BOT_TOKEN=your-telegram-bot-token
ADMIN_CHAT_ID=your-admin-chat-id
ORDER_TIME_ZONE=Asia/Phnom_Penh
# For Supabase pooler (recommended — port 6543):
#   The code auto-fixes the username to postgres.<project_ref> and
#   appends ?pgbouncer=true, so just use "postgres" as the user.
# For direct connection (port 5432):
#   postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://postgres:password@aws-0-region.pooler.supabase.com:6543/postgres
PORT=3000
WEB_APP_URL=https://your-https-domain.example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ABA PayWay Sandbox Credentials
ABA_MERCHANT_ID=your-merchant-id
ABA_PUBLIC_KEY=your-public-key
ABA_API_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/generate-qr
